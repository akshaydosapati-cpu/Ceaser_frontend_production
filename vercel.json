{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/r/:code", "destination": "/console/r/?code=:code" },
    { "source": "/verify/:certificateId", "destination": "/verify/?certificateId=:certificateId" }
  ]
}
